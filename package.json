{
  "name": "place-name-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "node scripts/local-stack.mjs --dev",
    "build": "node scripts/build.mjs",
    "preview:local": "node scripts/preview.mjs",
    "typecheck": "pnpm --filter @atlas/web typecheck",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "generate:client": "python3 scripts/generate-client.py",
    "local:status": "node scripts/inspect-local.mjs",
    "local:stop": "node scripts/stop-local.mjs",
    "local:diagnose-maps": "node scripts/map-browser-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vitest": "4.1.11",
    "typescript": "5.9.3",
    "@types/node": "26.5.1",
    "@mapbox/vector-tile": "3.0.0",
    "pbf": "5.1.2",
    "@axe-core/playwright": "4.13.0"
  }
}
