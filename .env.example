# Development only. Generate independent passwords before any deployment.
POSTGRES_PASSWORD=local-development-owner
RUNTIME_PASSWORD=local-development-runtime
IMPORT_PASSWORD=local-development-import
DATABASE_URL=postgresql+psycopg://atlas_runtime:local-development-runtime@127.0.0.1:5432/atlas
IMPORT_DATABASE_URL=postgresql+psycopg://atlas_import:local-development-import@127.0.0.1:5432/atlas
MIGRATION_DATABASE_URL=postgresql+psycopg://atlas_owner:local-development-owner@127.0.0.1:5432/atlas
# Local HTTP ports are configured in infra/local.json.
NUXT_PUBLIC_BASEMAP_URL=
NUXT_PUBLIC_BASEMAP_ATTRIBUTION=
